# Funcionalidad: Variables de la verificación local del stack de contenedores
# Descripción: Valores ficticios, solo para una máquina local, usados a la vez para la interpolación de docker-compose y como archivo de entorno del backend (BACKEND_ENV_FILE); no contiene secretos reales y nunca debe usarse en un servidor
# Versión: 1.0
# Autor: Marcela Mazo Castro
# Proyecto: VentyLab
# Tesis: Desarrollo de una aplicación web para la enseñanza de mecánica ventilatoria que integre un sistema de retroalimentación usando modelos de lenguaje
# Institución: Universidad del Valle
# Contacto: marcela.mazo@correounivalle.edu.co

# Compose interpolation
BACKEND_ENV_FILE=deploy/local/compose.env
API_DOMAIN=api.ventylab.localhost
MQTT_BACKEND_PASSWORD=local-only-backend-mqtt
MQTT_NODERED_PASSWORD=local-only-nodered-mqtt
MQTT_DEVICE_PASSWORD=local-only-device-mqtt
MQTT_HEALTHCHECK_PASSWORD=local-only-healthcheck-mqtt
NODE_RED_CREDENTIAL_SECRET=local-only-node-red-credential-secret
POSTGRES_USER=ventylab
POSTGRES_PASSWORD=local-only-postgres
POSTGRES_DB=ventylab

# Backend (NODE_ENV, PORT and MQTT_* connection values are set by docker-compose.yml)
DATABASE_URL=postgresql://ventylab:local-only-postgres@postgres:5432/ventylab
DIRECT_URL=postgresql://ventylab:local-only-postgres@postgres:5432/ventylab
JWT_SECRET=local-only-jwt-secret-0123456789abcdef
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=local-only-refresh-secret-0123456789abcdef
JWT_REFRESH_EXPIRES_IN=7d
NEXTAUTH_SECRET=local-only-nextauth-secret
NEXTAUTH_BRIDGE_SECRET=local-only-bridge-secret
ADMIN_API_KEY=local-only-admin-api-key
SUPERADMIN_EMAIL=superadmin@example.com
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PRODUCTION_URL=http://localhost:3000
CORS_ALLOW_VERCEL_PREVIEWS=false
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_FROM=no-reply@example.com
MQTT_COMMAND_ACK_TOPIC=ventilab/device/001/ack
APP_VERSION=local-compose
