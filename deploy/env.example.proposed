# Funcionalidad: Plantilla de variables de entorno del backend
# Descripción: Todas las variables que valida env.validation.ts (más las del arranque de Sentry y las de docker-compose) con valores de ejemplo no reales; copiar a .env y reemplazar cada valor marcado como change-me
# Versión: 1.1
# Autor: Marcela Mazo Castro
# Proyecto: VentyLab
# Tesis: Desarrollo de una aplicación web para la enseñanza de mecánica ventilatoria que integre un sistema de retroalimentación usando modelos de lenguaje
# Institución: Universidad del Valle
# Contacto: marcela.mazo@correounivalle.edu.co
#
# Full reference: docs/operations/environment-variables.md
# Startup fails with "Invalid environment configuration:" naming every missing or invalid variable.
# Lines starting with "# KEY=" are optional; uncomment them only when needed.

# ── Runtime ─────────────────────────────────────────────────────────────
# development | production | test (the container image forces production)
NODE_ENV=development
PORT=4000
# APP_VERSION=1.0.0            # defaults to package.json version
# APP_COMMIT_SHA=0000000       # alias: GIT_COMMIT

# ── Database (PostgreSQL; Supabase or own server) ───────────────────────
# Pooled URL used by the app; DIRECT_URL is used by prisma migrate (and by backups).
DATABASE_URL=postgresql://ventylab:change-me@localhost:5432/ventylab
DIRECT_URL=postgresql://ventylab:change-me@localhost:5432/ventylab

# ── Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-another-long-random-string-32-chars
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_API_KEY=change-me-admin-api-key
SUPERADMIN_EMAIL=superadmin@example.com
# GOOGLE_CLIENT_ID=example-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=change-me
# Comma-separated, leading @ optional; empty = any domain may sign in with Google.
# ALLOWED_EMAIL_DOMAINS=example.edu.co,example.com

# ── CORS and origins ────────────────────────────────────────────────────
# Comma-separated list; "*" allows any origin. FRONTEND_URL, PRODUCTION_URL and https://VERCEL_URL are added automatically.
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
PRODUCTION_URL=https://app.example.com
# VERCEL_URL=example-app.vercel.app
# true accepts every https://*.vercel.app origin (preview deployments); keep false in production.
CORS_ALLOW_VERCEL_PREVIEWS=false

# ── Rate limiting ───────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# ── Observability and API docs ──────────────────────────────────────────
# Sentry is initialized only when SENTRY_DSN is set and not empty.
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# /api/docs is open outside production; in production only for a request carrying an ADMIN access token.
# SWAGGER_ALLOWED_IPS only narrows it further by source IP: comma-separated IPs, or "*"/empty for no IP restriction.
# SWAGGER_ALLOWED_IPS=203.0.113.10,198.51.100.7
HEALTH_CHECK_TIMEOUT_MS=2000
SYSTEM_STATUS_CACHE_SECONDS=5

# ── Mail (SMTP) ─────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@example.com
SMTP_SECURE=false
# SMTP_USER=example-user
# SMTP_PASS=change-me

# ── MQTT (physical ventilator) ──────────────────────────────────────────
# Telemetry and commands are enabled only when MQTT_BROKER_URL (alias MQTT_URL) is set.
# In docker-compose.yml the broker URL, user and password are set from MQTT_BACKEND_* below.
# MQTT_BROKER_URL=mqtt://localhost:1883
# MQTT_CLIENT_ID=ventylab-server
# MQTT_USERNAME=ventylab-backend
# MQTT_PASSWORD=change-me
MQTT_TELEMETRY_TOPIC=/ventynet/data
MQTT_COMMAND_TOPIC=ventilab/device/001/command
MQTT_ALARM_TOPIC=ventilab/device/001/alarm
# Empty disables command ACK tracking.
MQTT_COMMAND_ACK_TOPIC=
MQTT_TEST_TOPIC_PREFIX=test/ventylab
MQTT_RECONNECT_BASE_MS=1000
MQTT_RECONNECT_MAX_MS=30000

# ── Ventilator telemetry ────────────────────────────────────────────────
VENTILATOR_DEVICE_ID=ventilab-device-001
VENTILATOR_TELEMETRY_DECODER=auto
VENTILATOR_FLUSH_INTERVAL_MS=33
VENTILATOR_MAX_BUFFERED_FRAMES=256
VENTILATOR_STALE_AFTER_MS=2000
VENTILATOR_ROOM_REFRESH_MS=1000
VENTILATOR_METRICS_WINDOW=10000
VENTILATOR_INVALID_LOG_INTERVAL_MS=5000
VENTILATOR_RECORDING_HZ=20
VENTILATOR_RECORDING_FLUSH_SECONDS=5
VENTILATOR_SEQ_REORDER_WINDOW=16
VENTILATOR_SEQ_WRAP_BITS=0

# ── Ventilator commands and safety limits ───────────────────────────────
VENTILATOR_COMMAND_ENCODING=json
VENTILATOR_COMMAND_TIMEOUT_MS=3000
VENTILATOR_COMMAND_RATE_PER_SECOND=5
VENTILATOR_OPERATOR_GRACE_SECONDS=15
VENTILATOR_CONTROL_REFRESH_MS=1000
VENTILATOR_APPLY_TOLERANCE_RATIO=0.05
VENTILATOR_SAFETY_MAX_PEEP=15
VENTILATOR_SAFETY_MAX_PRESSURE_LIMIT=40
VENTILATOR_SAFETY_MAX_TIDAL_VOLUME=700
VENTILATOR_SAFETY_MAX_RESPIRATORY_RATE=35
VENTILATOR_SAFETY_MAX_IE_RATIO=1

# ── Reservations ────────────────────────────────────────────────────────
RESERVATION_MAX_DURATION_MINUTES=120
RESERVATION_SLOT_MINUTES=15
RESERVATION_MAX_ADVANCE_DAYS=14
RESERVATION_MAX_FUTURE_PER_STUDENT=3
RESERVATION_MAX_FUTURE_PER_GROUP=5

# ── InfluxDB (optional telemetry storage) ───────────────────────────────
# INFLUXDB_URL=http://localhost:8086
# INFLUXDB_TOKEN=change-me
# INFLUXDB_ORG=example-org
# INFLUXDB_BUCKET=ventylab

# ── AI gateway ──────────────────────────────────────────────────────────
# GEMINI_API_KEY=change-me
# OPENAI_API_KEY=change-me
# OPENAI_BASE_URL=https://api.openai.example.com/v1
# ANTHROPIC_API_KEY=change-me
# ANTHROPIC_BASE_URL=https://api.anthropic.example.com
# AI_CUSTOM_HTTP_ENDPOINT=http://localhost:8080/v1/complete
# AI_CUSTOM_HTTP_AUTH_HEADER=Authorization
# AI_CUSTOM_HTTP_AUTH_VALUE=Bearer change-me
# JSON overrides (validated at startup); see docs/operations/environment-variables.md for the shapes.
# AI_USE_CASE_SETTINGS={"FREE_CHAT":{"timeoutMs":20000}}
# AI_QUOTAS={"STUDENT":{"*":50}}
# AI_PRICES={"openai":{"example-model":{"inputPer1kUsd":0.001,"outputPer1kUsd":0.002}}}
AI_BREAKER_FAILURE_THRESHOLD=3
AI_BREAKER_OPEN_SECONDS=60
AI_TUTOR_HISTORY_WINDOW=10
AI_TUTOR_CONTEXT_TOKEN_BUDGET=6000

# ── Media storage (Supabase Storage) ────────────────────────────────────
# SUPABASE_URL=https://example-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=change-me
# SUPABASE_STORAGE_BUCKET=media
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_FILE_BYTES=20971520
MEDIA_MAX_VIDEO_BYTES=104857600
MEDIA_SIGNED_URL_TTL_SECONDS=3600

# ── Evaluation and simulation ───────────────────────────────────────────
EVALUATION_PASSING_GRADE=3.0
SIMULATION_EVENT_TIME_TOLERANCE_MS=5000
SIMULATION_ABANDON_AFTER_MINUTES=30
SIMULATION_MAX_EVENT_BATCH_SIZE=200

# ── Analytics ───────────────────────────────────────────────────────────
# Required (min 16 chars) for the anonymized research export; without it that route answers 503.
# ANALYTICS_EXPORT_SALT=change-me-at-least-16-characters

# ── docker-compose.yml only (interpolation; not read by the app) ────────
# BACKEND_ENV_FILE=.env
# BACKEND_IMAGE=ghcr.io/example-owner/ventylab-server:main
# API_DOMAIN=api.example.com
# TRAEFIK_NETWORK=dokploy-network
# TRAEFIK_HTTPS_ENTRYPOINT=websecure
# TRAEFIK_HTTP_ENTRYPOINT=web
# TRAEFIK_CERT_RESOLVER=letsencrypt
# MQTT_BIND_ADDRESS=127.0.0.1
# MQTT_PUBLIC_PORT=1883
# MQTT_BACKEND_USERNAME=ventylab-backend
# MQTT_BACKEND_PASSWORD=change-me
# MQTT_NODERED_USERNAME=ventylab-nodered
# MQTT_NODERED_PASSWORD=change-me
# MQTT_DEVICE_USERNAME=ventylab-device
# MQTT_DEVICE_PASSWORD=change-me
# MQTT_HEALTHCHECK_USERNAME=ventylab-healthcheck
# MQTT_HEALTHCHECK_PASSWORD=change-me
# NODE_RED_CREDENTIAL_SECRET=change-me
# NODE_RED_PORT=1880
# TZ=America/Bogota
# POSTGRES_USER=ventylab
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=ventylab
