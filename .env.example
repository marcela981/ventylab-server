# Funcionalidad: Ejemplo de variables de entorno del backend para desarrollo local
# Descripción: Todas las variables que valida env.validation.ts agrupadas por bloque, con valores de ejemplo no reales; las obligatorias van sin comentar y las opcionales o con valor por defecto van comentadas con su valor por defecto; copiar a .env y reemplazar cada valor marcado como change-me
# Versión: 1.1
# Autor: Marcela Mazo Castro
# Proyecto: VentyLab
# Tesis: Desarrollo de una aplicación web para la enseñanza de mecánica ventilatoria que integre un sistema de retroalimentación usando modelos de lenguaje
# Institución: Universidad del Valle
# Contacto: marcela.mazo@correounivalle.edu.co
#
# Full reference: docs/operations/environment-variables.md
# Startup fails with "Invalid environment configuration:" naming every missing or invalid variable.
# Lines starting with "# KEY=" are optional (or show the code default); uncomment them only when needed.

# ── Application ────────────────────────────────────────────────────────
# Runtime environment: development | production | test
NODE_ENV=development

# HTTP port the server listens on.
PORT=4000

# Version and commit reported by the system status endpoints.
# APP_VERSION defaults to the package.json version; GIT_COMMIT is an alias of APP_COMMIT_SHA.
# APP_VERSION=1.0.0
# APP_COMMIT_SHA=0000000
# GIT_COMMIT=0000000

# Timeout of each health check (ms, 100–10000) and cache of the system status (s, 5–10).
# HEALTH_CHECK_TIMEOUT_MS=2000
# SYSTEM_STATUS_CACHE_SECONDS=5

# ── Database (PostgreSQL via Prisma) ───────────────────────────────────
# Pooled Postgres connection string used by the application at runtime.
# Matches the compose.development.yml service for local development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ventylab

# Direct (non-pooled) connection string used by Prisma migrations.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ventylab

# ── JWT authentication ─────────────────────────────────────────────────
# Secret used to sign access tokens. Use a long random string in production.
JWT_SECRET=change-me-access-token-secret

# Access token lifetime (zeit/ms format: 60s, 15m, 1h, 7d).
JWT_EXPIRES_IN=15m

# Secret used to sign refresh tokens. Must differ from JWT_SECRET.
JWT_REFRESH_SECRET=change-me-refresh-token-secret

# Refresh token lifetime.
JWT_REFRESH_EXPIRES_IN=7d

# ── Identity ───────────────────────────────────────────────────────────
# Email of the immutable superadmin; on startup that account (if it exists) is kept ADMIN and active.
SUPERADMIN_EMAIL=superadmin@example.com

# Google sign-in. Without GOOGLE_CLIENT_ID, POST /api/auth/google answers "not configured".
# GOOGLE_CLIENT_ID=example-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=change-me

# Comma-separated domains allowed to sign in with Google (leading @ optional); empty = any domain.
# ALLOWED_EMAIL_DOMAINS=example.edu.co,example.com

# ── NextAuth bridge ────────────────────────────────────────────────────
# Optional: no backend code reads it (the frontend no longer uses NextAuth).
# NEXTAUTH_SECRET=change-me-nextauth-secret

# Shared secret the frontend must send when exchanging a NextAuth session for a backend token.
NEXTAUTH_BRIDGE_SECRET=change-me-nextauth-bridge-secret

# ── Bootstrap / administration ─────────────────────────────────────────
# Optional: value of the x-admin-api-key header checked by AdminApiKeyGuard, which no route applies today.
# ADMIN_API_KEY=change-me-admin-api-key

# ── CORS ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for any origin.
# FRONTEND_URL, PRODUCTION_URL and https://VERCEL_URL are allowed too.
CORS_ORIGIN=http://localhost:3000

# Frontend URL (local or deployed).
FRONTEND_URL=http://localhost:3000

# Production frontend URL.
PRODUCTION_URL=https://ventylab.vercel.app

# Vercel deployment host without protocol (set automatically by Vercel).
# VERCEL_URL=

# true accepts every https://*.vercel.app origin (preview deployments); keep false in production.
# CORS_ALLOW_VERCEL_PREVIEWS=false

# ── Rate limiting ──────────────────────────────────────────────────────
# Throttle window in milliseconds.
THROTTLE_TTL=60000

# Max requests per window per client.
THROTTLE_LIMIT=100

# ── Observability ──────────────────────────────────────────────────────
# Sentry DSN. Leave unset to disable Sentry entirely (e.g. local dev).
# SENTRY_DSN=

# ── API docs (Scalar at /api/docs) ─────────────────────────────────────
# Open outside production; in production only for a request carrying an ADMIN access token.
# Comma-separated list of IPs that narrows access further, or * / empty for no IP restriction.
SWAGGER_ALLOWED_IPS=*

# ── Email (SMTP) ───────────────────────────────────────────────────────
# SMTP server host. The compose file ships mailpit for local development.
SMTP_HOST=localhost

# SMTP server port (mailpit listens on 1025).
SMTP_PORT=1025

# From address for outgoing email.
SMTP_FROM=no-reply@example.com

# SMTP credentials. Leave both unset for servers without auth (mailpit).
# SMTP_USER=
# SMTP_PASS=

# Whether to use TLS from the first byte (true for port 465).
SMTP_SECURE=false

# ── Physical ventilator (MQTT) — optional ──────────────────────────────
# Telemetry and commands are enabled only when MQTT_BROKER_URL (alias MQTT_URL) is set.
# MQTT_BROKER_URL=mqtt://test.mosquitto.org:1883
# MQTT_URL=
# MQTT_CLIENT_ID=ventylab-server
# MQTT_USERNAME=
# MQTT_PASSWORD=
# Topics must match the ventilator publisher exactly (values below are the code defaults).
# MQTT_TELEMETRY_TOPIC=/ventynet/data
# MQTT_COMMAND_TOPIC=ventilab/device/001/command
# MQTT_ALARM_TOPIC=ventilab/device/001/alarm
# Empty disables command ACK tracking.
# MQTT_COMMAND_ACK_TOPIC=
# Prefix of the topics used by the hardware tests (must start with a letter or digit).
# MQTT_TEST_TOPIC_PREFIX=test/ventylab
# Reconnect backoff: base delay and cap (ms).
# MQTT_RECONNECT_BASE_MS=1000
# MQTT_RECONNECT_MAX_MS=30000

# ── Ventilator telemetry ───────────────────────────────────────────────
# Device id, also the key of the reservation advisory lock.
# VENTILATOR_DEVICE_ID=ventilab-device-001
# Frame decoder: auto | json | hex.
# VENTILATOR_TELEMETRY_DECODER=auto
# Interval (ms, 5–1000) of the batched ventilator:telemetry flush to Socket.io clients.
# VENTILATOR_FLUSH_INTERVAL_MS=33
# VENTILATOR_MAX_BUFFERED_FRAMES=256
# VENTILATOR_STALE_AFTER_MS=2000
# VENTILATOR_ROOM_REFRESH_MS=1000
# VENTILATOR_METRICS_WINDOW=10000
# VENTILATOR_INVALID_LOG_INTERVAL_MS=5000
# VENTILATOR_RECORDING_HZ=20
# VENTILATOR_RECORDING_FLUSH_SECONDS=5
# VENTILATOR_SEQ_REORDER_WINDOW=16
# Sequence wrap-around bits: 0 (none) | 16 | 32.
# VENTILATOR_SEQ_WRAP_BITS=0

# ── Ventilator commands and safety limits ──────────────────────────────
# Command encoding: json | hex.
# VENTILATOR_COMMAND_ENCODING=json
# VENTILATOR_COMMAND_TIMEOUT_MS=3000
# VENTILATOR_COMMAND_RATE_PER_SECOND=5
# VENTILATOR_OPERATOR_GRACE_SECONDS=15
# VENTILATOR_CONTROL_REFRESH_MS=1000
# VENTILATOR_APPLY_TOLERANCE_RATIO=0.05
# VENTILATOR_SAFETY_MAX_PEEP=15
# VENTILATOR_SAFETY_MAX_PRESSURE_LIMIT=40
# VENTILATOR_SAFETY_MAX_TIDAL_VOLUME=700
# VENTILATOR_SAFETY_MAX_RESPIRATORY_RATE=35
# VENTILATOR_SAFETY_MAX_IE_RATIO=1

# ── Reservations ───────────────────────────────────────────────────────
# RESERVATION_MAX_DURATION_MINUTES=120
# RESERVATION_SLOT_MINUTES=15
# RESERVATION_MAX_ADVANCE_DAYS=14
# RESERVATION_MAX_FUTURE_PER_STUDENT=3
# RESERVATION_MAX_FUTURE_PER_GROUP=5

# ── Telemetry storage (InfluxDB v2) — optional ─────────────────────────
# INFLUXDB_URL=http://localhost:8086
# INFLUXDB_TOKEN=
# INFLUXDB_ORG=
# INFLUXDB_BUCKET=

# ── AI gateway — optional ──────────────────────────────────────────────
# Leave every provider unset to disable AI; AI endpoints then answer 503.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.example.com/v1
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.example.com
# AI_CUSTOM_HTTP_ENDPOINT=http://localhost:8080/v1/complete
# AI_CUSTOM_HTTP_AUTH_HEADER=Authorization
# AI_CUSTOM_HTTP_AUTH_VALUE=Bearer change-me
# JSON overrides (validated at startup); see docs/operations/environment-variables.md for the shapes.
# AI_USE_CASE_SETTINGS={"FREE_CHAT":{"timeoutMs":20000}}
# AI_QUOTAS={"STUDENT":{"*":50}}
# AI_PRICES={"openai":{"example-model":{"inputPer1kUsd":0.001,"outputPer1kUsd":0.002}}}
# Circuit breaker and tutor context.
# AI_BREAKER_FAILURE_THRESHOLD=3
# AI_BREAKER_OPEN_SECONDS=60
# AI_TUTOR_HISTORY_WINDOW=10
# AI_TUTOR_CONTEXT_TOKEN_BUDGET=6000

# ── Media storage (Supabase Storage) — optional ────────────────────────
# SUPABASE_URL=https://example-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=change-me
# SUPABASE_STORAGE_BUCKET=media
# Upload limits (bytes) and signed URL lifetime (s).
# MEDIA_MAX_IMAGE_BYTES=10485760
# MEDIA_MAX_FILE_BYTES=20971520
# MEDIA_MAX_VIDEO_BYTES=104857600
# MEDIA_SIGNED_URL_TTL_SECONDS=3600

# ── Evaluation and simulation ──────────────────────────────────────────
# Minimum passing grade (0–5).
# EVALUATION_PASSING_GRADE=3.0
# SIMULATION_EVENT_TIME_TOLERANCE_MS=5000
# SIMULATION_ABANDON_AFTER_MINUTES=30
# SIMULATION_MAX_EVENT_BATCH_SIZE=200

# ── Analytics ──────────────────────────────────────────────────────────
# Required (min 16 chars) for the anonymized research export; without it that route answers 503.
# ANALYTICS_EXPORT_SALT=change-me-at-least-16-characters
