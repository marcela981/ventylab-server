# ── Application ────────────────────────────────────────────────────────
# Runtime environment: development | production | test
NODE_ENV=development

# HTTP port the server listens on.
PORT=4000

# ── Database (PostgreSQL via Prisma) ───────────────────────────────────
# Pooled Postgres connection string used by the application at runtime.
# Matches the compose.development.yml service for local development.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ventylab

# Direct (non-pooled) connection string used by Prisma migrations.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/ventylab

# ── JWT authentication ─────────────────────────────────────────────────
# Secret used to sign access tokens. Use a long random string in production.
JWT_SECRET=change-me-access-token-secret

# Access token lifetime (zeit/ms format: 60s, 15m, 1h, 7d).
JWT_EXPIRES_IN=15m

# Secret used to sign refresh tokens. Must differ from JWT_SECRET.
JWT_REFRESH_SECRET=change-me-refresh-token-secret

# Refresh token lifetime.
JWT_REFRESH_EXPIRES_IN=7d

# ── NextAuth bridge ────────────────────────────────────────────────────
# Secret shared with the frontend NextAuth configuration.
NEXTAUTH_SECRET=change-me-nextauth-secret

# Shared secret the frontend must send when exchanging a NextAuth session for a backend token.
NEXTAUTH_BRIDGE_SECRET=change-me-nextauth-bridge-secret

# ── Bootstrap / administration ─────────────────────────────────────────
# API key required by the x-admin-api-key header on administrative bootstrap endpoints.
ADMIN_API_KEY=change-me-admin-api-key

# ── CORS ───────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for any origin.
# FRONTEND_URL, PRODUCTION_URL, VERCEL_URL and any https://*.vercel.app origin are allowed too.
CORS_ORIGIN=http://localhost:3000

# Frontend URL (local or deployed).
FRONTEND_URL=http://localhost:3000

# Production frontend URL.
PRODUCTION_URL=https://ventylab.vercel.app

# Vercel deployment host without protocol (set automatically by Vercel).
# VERCEL_URL=

# ── Rate limiting ──────────────────────────────────────────────────────
# Throttle window in milliseconds.
THROTTLE_TTL=60000

# Max requests per window per client.
THROTTLE_LIMIT=100

# ── Observability ──────────────────────────────────────────────────────
# Sentry DSN. Leave unset to disable Sentry entirely (e.g. local dev).
# SENTRY_DSN=

# ── API docs (Scalar at /api/docs) ─────────────────────────────────────
# Comma-separated list of IPs allowed to open the docs, or * for everyone.
# Leave unset to disable the docs entirely.
SWAGGER_ALLOWED_IPS=*

# ── Email (SMTP) ───────────────────────────────────────────────────────
# SMTP server host. The compose file ships mailpit for local development.
SMTP_HOST=localhost

# SMTP server port (mailpit listens on 1025).
SMTP_PORT=1025

# From address for outgoing email.
SMTP_FROM=no-reply@example.com

# SMTP credentials. Leave both unset for servers without auth (mailpit).
# SMTP_USER=
# SMTP_PASS=

# Whether to use TLS from the first byte (true for port 465).
SMTP_SECURE=false

# ── Physical ventilator (MQTT) — optional ──────────────────────────────
# MQTT_BROKER_URL=mqtt://test.mosquitto.org:1883
# MQTT_CLIENT_ID=ventylab-server
# MQTT_USERNAME=
# MQTT_PASSWORD=
# Topics must match the ventilator publisher exactly.
# MQTT_TELEMETRY_TOPIC=/ventynet/data
# MQTT_COMMAND_TOPIC=/ventynet/commands
# MQTT_ALARM_TOPIC=/ventynet/alarms

# Max frequency (Hz) of telemetry frames pushed to WebSocket clients.
# WS_MAX_HZ=30

# ── Telemetry storage (InfluxDB v2) — optional ─────────────────────────
# INFLUXDB_URL=http://localhost:8086
# INFLUXDB_TOKEN=
# INFLUXDB_ORG=
# INFLUXDB_BUCKET=

# ── AI (Google Gemini) — optional ──────────────────────────────────────
# Leave unset to disable AI feedback; AI endpoints then answer 503.
# GEMINI_API_KEY=
